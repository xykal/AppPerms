<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Untuk daftar aplikasi + label/ikon. Tanpa ini hanya app kita sendiri yang terlihat. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- OPTIMIZED v1.5: SYSTEM_ALERT_WINDOW tetap perlu untuk KELOLA overlay app lain,
         tapi TIDAK PERNAH dipakai untuk memasang overlay sendiri lagi (GhostGuard dimatikan).
         Tetap TANPA izin internet seperti sebelumnya. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- v1.5: FOREGROUND_SERVICE dihapus karena GhostGuard dimatikan permanen.
         Tidak ada lagi service yang bikin panas/boros baterai. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />

    <application
        android:name=".AppsPermsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OverlayOps">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:label="@string/nav_about" />

        <activity
            android:name=".ui.TerminalActivity"
            android:exported="false"
            android:label="@string/nav_terminal" />

        <activity
            android:name=".ui.TweaksActivity"
            android:exported="false"
            android:label="@string/nav_tweaks" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/nav_settings" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/nav_history" />

        <!-- Simpan pilihan bahasa otomatis di Android < 13 (dipakai AppCompat). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Wajib untuk Shizuku: mengizinkan Shizuku mengirim binder user service ke app ini -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- v1.5 OPTIMIZED: GhostGuard DINONAKTIFKAN PERMANEN (anti panas/lag).
             Service tetap dideklarasikan enabled=false agar upgrade dari versi lama tidak crash,
             tapi tidak akan pernah dijalankan. -->
        <service
            android:name=".guard.GhostGuardService"
            android:enabled="false"
            android:exported="false" />

        <receiver
            android:name=".guard.GhostGuardReceiver"
            android:enabled="false"
            android:exported="false" />

    </application>

</manifest>
