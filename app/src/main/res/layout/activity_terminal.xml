<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/termToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_container"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_menu"
        app:title="@string/nav_terminal"
        app:titleTextColor="@color/on_surface"
        app:subtitle="LADB &amp; Shell Runner via Shizuku"
        app:subtitleTextColor="@color/on_surface_dim" />

    <!-- Terminal Status Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container_low"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <View
            android:id="@+id/termStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/termStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="@string/term_status_shell_ready"
            android:textColor="@color/ok"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/termMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/term_meta_idle"
            android:textColor="@color/on_surface_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Preset Chips (Horizontal Scrolling) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container_low"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/termPresetGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true" />
    </HorizontalScrollView>

    <!-- Terminal Console Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0C10">

        <ScrollView
            android:id="@+id/termScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="12dp">

            <TextView
                android:id="@+id/termOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:text="@string/term_output_empty"
                android:textColor="#ECEFF4"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>

        <!-- Floating Quick Tools (Copy, Clear) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_chip_small"
            android:orientation="horizontal"
            android:padding="2dp">

            <ImageButton
                android:id="@+id/termCopy"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/term_copy_output"
                android:src="@drawable/ic_copy" />

            <ImageButton
                android:id="@+id/termClear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/term_clear_label"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
    </FrameLayout>

    <!-- Command Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:fontFamily="monospace"
            android:text="$"
            android:textColor="@color/brand"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/termInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:fontFamily="monospace"
            android:hint="@string/term_input_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:paddingHorizontal="12dp"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_dim"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/termRun"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="@string/term_run_label"
            android:textStyle="bold"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
