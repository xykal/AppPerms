<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/aboutToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_container"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_menu"
        app:title="@string/nav_about"
        app:titleTextColor="@color/on_surface"
        app:subtitle="@string/about_credit"
        app:subtitleTextColor="@color/on_surface_dim" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hero App Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/aboutHeroIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_logo_appsperms" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/app_name"
                    android:textColor="@color/on_surface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aboutVersionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_chip_small"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/brand"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/about_tagline"
                    android:textColor="@color/on_surface_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Card: Privacy & Security Guarantee -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_privacy_title"
                    android:textColor="@color/brand"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/about_privacy_body"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_small"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="0 Izin Internet"
                        android:textColor="@color/ok"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_small"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="VirusTotal 0/64 Clean"
                        android:textColor="@color/ok"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card: Quick Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TAUTAN RESMI &amp; PANDUAN"
                    android:textColor="@color/brand"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAboutWebsite"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="42dp"
                        android:text="@string/about_website"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAboutSource"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:minHeight="42dp"
                        android:text="@string/about_source"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAboutUpdate"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="42dp"
                        android:text="@string/about_check_update"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAboutChannel"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:minHeight="42dp"
                        android:text="@string/about_channel"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAboutFaq"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="42dp"
                    android:text="@string/about_faq"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAboutFeedback"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="42dp"
                    android:text="@string/about_feedback"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Card: JUGA DARI XYVERSE (Horizontal Carousel with REAL App Logos) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:text="@string/about_ecosystem_title"
                    android:textColor="@color/brand"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingHorizontal="16dp"
                    android:text="Geser untuk menjelajahi aplikasi resmi ekosistem XyVerse"
                    android:textColor="@color/on_surface_dim"
                    android:textSize="11sp" />

                <!-- Horizontal Scrolling Carousel -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Item 1: AppsPerms (Current App) -->
                        <LinearLayout
                            android:id="@+id/cardEcosystemAppsPerms"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_search"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:contentDescription="AppsPerms"
                                android:src="@drawable/ic_logo_appsperms" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="AppsPerms"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/bg_chip_small"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="AppOps &amp; Security"
                                android:textColor="@color/brand"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="Manajer AppOps &amp; tuning Shizuku tanpa root"
                                android:textColor="@color/on_surface_dim"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Item 2: XyDesk -->
                        <LinearLayout
                            android:id="@+id/cardEcosystemXyDesk"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_search"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:contentDescription="XyDesk"
                                android:src="@drawable/ic_logo_xydesk" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="XyDesk"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/bg_chip_small"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="Remote Desktop"
                                android:textColor="#00A3FF"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="Remote control &amp; admin PC dari HP dan Web"
                                android:textColor="@color/on_surface_dim"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Item 3: XyCloudStore -->
                        <LinearLayout
                            android:id="@+id/cardEcosystemXyCloud"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_search"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:contentDescription="XyCloudStore"
                                android:src="@drawable/ic_logo_xycloud" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="XyCloudStore"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/bg_chip_small"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="Store &amp; Cloud"
                                android:textColor="#10B981"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="Toko aplikasi &amp; penyimpanan cloud pribadi"
                                android:textColor="@color/on_surface_dim"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Item 4: XyStudio AI -->
                        <LinearLayout
                            android:id="@+id/cardEcosystemXyStudio"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_search"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:contentDescription="XyStudio AI"
                                android:src="@drawable/ic_logo_xystudio" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="XyStudio AI"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/bg_chip_small"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="AI Studio &amp; Dev"
                                android:textColor="#A855F7"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="Studio AI cerdas untuk otomasi dan dev tools"
                                android:textColor="@color/on_surface_dim"
                                android:textSize="10sp" />
                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Card: Contributors & Special Appreciation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_contributors_title"
                    android:textColor="@color/brand"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/about_contributors_body"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Card: License & Legal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LISENSI &amp; LEGALITAS"
                    android:textColor="@color/brand"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="AppsPerms dilisensikan di bawah Apache License 2.0 (Open Source). Bebas digunakan, diaudit, dan dikembangkan kembali secara transparan."
                    android:textColor="@color/on_surface_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Bottom Credit -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="@string/about_credit"
                android:textColor="@color/on_surface_dim"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
