# Global browser hardening. The site has no third-party scripts or analytics.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

# HTML and release discovery documents must revalidate after every deployment.
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"

/privacy
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow

/privacy.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow

/thanks
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/thanks.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/404.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/data/*
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex, nofollow

# Pages hosts no APK binaries. These mutable compatibility paths are short-lived
# redirects to the exact immutable GitHub Release asset.
/apk/AppsPerms-latest.apk
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/AppsPerms-latest.apk
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: index, follow

/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
