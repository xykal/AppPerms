# Security & Caching Headers untuk AppsPerms
# Cloudflare Pages _headers format

/apk/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

/AppsPerms-latest.apk
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="AppsPerms-latest.apk"
  X-Content-Type-Options: nosniff

/AppsPerms-debug-latest.apk
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="AppsPerms-debug-latest.apk"

/sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: index, follow

/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: text/plain; charset=utf-8

/googleb2a7847179613098.html
  Cache-Control: public, max-age=3600
  Content-Type: text/html; charset=utf-8

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), browsing-topics=()
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/html; charset=utf-8
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"

/thanks.html
  Cache-Control: public, max-age=0, must-revalidate
