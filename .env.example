# XyVerse Env Example - Aman, jangan hardcode secret asli
# Copy jadi .env di lokal, jangan pernah commit .env

# GitHub - Buat PAT baru fine-grained di https://github.com/settings/tokens?type=beta
# Permission: Contents Read & Write, Metadata Read, owner: xykal
GITHUB_TOKEN=github_pat_xxx_ganti_dengan_token_baru
GH_PAT_SYNC=github_pat_xxx_ganti_dengan_token_baru

# Resend
RESEND_API_KEY=re_xxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# TwicPics
TWICPICS_API_KEY=xxx

# Cloudflare
CLOUDFLARE_TOKEN=xxx

# Vercel
VERCEL_TOKEN=vcp_xxx

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# OneSignal - Jangan tukar key antar app
ONESIGNAL_APP_ID_XYCLOUDSTORE=f4843c35-cc1d-4772-9f70-1c4349397ffb
ONESIGNAL_API_KEY_XYCLOUDSTORE=os_v2_app_xxx
ONESIGNAL_APP_ID_XYDESK=e3d5adea-1c0f-4986-9ce5-e088d65f0998
ONESIGNAL_API_KEY_XYDESK=os_v2_app_xxx

# Groq/Grok
GROQ_API_KEY_XYSTUDIO=gsk_xxx
GROQ_API_KEY_XYCLOUDSTORE=gsk_xxx

# Google OAuth - Jangan taruh secret di frontend
GOOGLE_CLIENT_ID_XYDESK_APK=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID_XYDESK_WEB=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# PAKASIR
PAKASIR_PROJECT=xycloudstore
PAKASIR_API_KEY=xxx

# XyVerse Branding
XYVERSE_LOGO_PACK=https://filebin.net/xyverse-logo-pack-9f3k2
